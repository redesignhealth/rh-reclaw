# reclaw-ea-mcp local dev config. Copy to .env (gitignored) and fill in.
# See README.md's "Running locally" section.

OKTA_ISSUER_URL=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

# Stable JWT signing secret (Terraform-provisioned in prod, any string locally).
MCP_JWT_SECRET=

# Shared HS256 secret for rh-auth Bearer tokens (Terraform-provisioned in prod).
RH_AUTH_SECRET=

# Optional -- defaults shown, EXCEPT MCP_TOKEN_STORAGE_PATH (see below).
# BASE_URL=http://localhost:8081
# MCP_HOST=127.0.0.1
# MCP_PORT=8081
# LOG_LEVEL=INFO

# NOT commented out, unlike the others above (Argus round 3 finding: the
# documented quickstart failed locally without this).
#
# LOCAL DEV ONLY -- MUST be absent from ECS/Terraform environment blocks.
# The real ECS default (auth.py) is /data/fastmcp-tokens, an EFS mount
# that only exists on ECS and is applied automatically -- no explicit env
# var needed there. Copying this file verbatim into a task definition
# would silently override that EFS-backed default with /tmp below,
# losing every stored OAuth token on the next task replacement. (Argus
# round 6 finding: an earlier version of this file also listed the ECS
# default as a second, commented-out MCP_TOKEN_STORAGE_PATH= line --
# removed, since a duplicate assignment of the same key in a file this
# warning is explicitly about copy-paste accidents made the hazard worse,
# not more discoverable, than just stating the default in prose here.)
MCP_TOKEN_STORAGE_PATH=/tmp/reclaw-ea-mcp-tokens

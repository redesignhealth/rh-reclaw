# reclaw-ea-mcp local dev config. Copy to .env (gitignored) and fill in.
# See README.md's "Running locally" section.

OKTA_ISSUER_URL=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

# Stable JWT signing secret (Terraform-provisioned in prod, any string locally).
MCP_JWT_SECRET=

# Shared HS256 secret for rh-auth Bearer tokens (Terraform-provisioned in prod).
RH_AUTH_SECRET=

# Optional -- defaults shown, EXCEPT MCP_TOKEN_STORAGE_PATH (see below).
# BASE_URL=http://localhost:8081
# MCP_HOST=127.0.0.1
# MCP_PORT=8081
# LOG_LEVEL=INFO

# NOT commented out, unlike the others above (Argus round 3 finding: the
# documented quickstart failed locally without this) -- the real default
# (auth.py) is /data/fastmcp-tokens, an EFS mount that only exists on ECS;
# it fails to create locally (read-only /).
#
# LOCAL DEV ONLY (Argus round 4 finding: the warning above used to say
# "don't uncomment-and-forget," backwards now that this line is
# pre-uncommented) -- this line MUST be absent from ECS/Terraform
# environment blocks. Copying this file verbatim into a task definition
# would silently override the EFS-backed /data/fastmcp-tokens default
# with /tmp, losing every stored OAuth token on the next task replacement.
MCP_TOKEN_STORAGE_PATH=/tmp/reclaw-ea-mcp-tokens

# reclaw-comms-mcp local development configuration.
# Copy to .env (gitignored) and fill in real values — never commit secrets.
# In production, all secrets are injected from SSM Parameter Store by the
# mcp-server Terraform module; this file exists for local dev only.

# --- Required (the service fails fast at startup if any is missing) ---

# Okta OIDC for interactive (human) callers
OKTA_ISSUER_URL=https://<your-okta-domain>/oauth2/default
OKTA_CLIENT_ID=<okta-app-client-id>
OKTA_CLIENT_SECRET=<okta-app-client-secret>

# Signing secret for FastMCP's internal JWTs
# (prod: Terraform-provisioned, SSM /rh-platform-{env}/reclaw-comms-mcp/jwt-secret)
MCP_JWT_SECRET=<generate-a-long-random-string>

# Shared HS256 secret for rh-auth agent JWTs
# (prod: SSM /general/{env}/rh-auth-secret)
RH_AUTH_SECRET=<rh-auth-shared-secret>

# --- Optional (documented defaults) ---

# Public URL of this MCP server (default: http://localhost:8080)
#BASE_URL=http://localhost:8080

# Persistent OAuth token storage (default: /data/fastmcp-tokens, EFS on ECS)
#MCP_TOKEN_STORAGE_PATH=/data/fastmcp-tokens

# Bind host/port (defaults: 127.0.0.1 / 8080; docker-compose sets MCP_HOST=0.0.0.0)
#MCP_HOST=127.0.0.1
#MCP_PORT=8080

# Postgres for the comms domain (agents/conversations/participants/
# messages/audit_log — DESIGN.md §5). Provisioned in docker-compose, which
# maps the container's Postgres to HOST port 55432 (not 5432) to avoid
# colliding with a native Postgres many dev machines already run on 5432 —
# see README.md's "Local development" section. Required once the service
# actually opens a DB session; run `uv run alembic upgrade head` after
# setting this to create the schema.
#DATABASE_URL=postgresql://postgres:postgres@localhost:55432/reclaw_comms

#LOG_LEVEL=INFO
